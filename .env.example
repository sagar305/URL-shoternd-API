# ---------------------------------------------------------------------------
# Setu URL shortener — service configuration
#
# Copy to .env for local work. On Railway set the same keys as service
# variables; nothing here has a safe default that works in production.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/setu-links?retryWrites=true&w=majority

# Shared secret the Setu site's server-side proxy sends as the x-api-key header.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is the only thing standing between this service and the open internet —
# it must never be exposed to a browser (so never a NEXT_PUBLIC_ variable).
API_KEY=

# Comma-separated origins allowed to call this directly from a browser. Normally
# left empty: traffic arrives from the Next.js proxy, which sends no Origin.
ALLOWED_ORIGINS=https://setutechnology.com,https://www.setutechnology.com

# Where a code becomes a page again. Used to build the `url` in responses.
SHORT_URL_BASE=https://setutechnology.com/view

# Sliding lifetime. Every read and every edit pushes deletion this far out again.
LINK_TTL_DAYS=180

# Maximum stored payload, in bytes (default 256 KB).
MAX_PAYLOAD_BYTES=262144

# PORT is deliberately not listed here.
#
# Railway injects it to match the port its edge routes to. Setting it yourself
# — including by pasting this file wholesale into the service's variables —
# pins the app to a port the edge may not be sending traffic to, and every
# request then fails with "connection refused" even though the container is
# healthy. Leave it unset in production. For a local run, pass it inline:
#
#   PORT=8080 npm run dev
