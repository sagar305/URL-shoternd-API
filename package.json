{
  "name": "setu-url-shortener-api",
  "version": "1.0.0",
  "private": true,
  "description": "Short-link service for Setu Technology's free tools. Stores an opaque tool payload and hands back a 10-character code.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
